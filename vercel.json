{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/real-estate",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ai-content",
      "destination": "/services/creative-assistant",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/plans",
      "permanent": true
    },
    {
      "source": "/case-studies",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/process",
      "destination": "/#how-it-works",
      "permanent": true
    },
    {
      "source": "/services/web-development",
      "destination": "/services/technical-assistant",
      "permanent": true
    },
    {
      "source": "/services/custom-software",
      "destination": "/services/technical-assistant",
      "permanent": true
    },
    {
      "source": "/services/crm-development",
      "destination": "/services/technical-assistant",
      "permanent": true
    },
    {
      "source": "/services/ai-automation",
      "destination": "/services/technical-assistant",
      "permanent": true
    },
    {
      "source": "/services/ai-assistants",
      "destination": "/services/technical-assistant",
      "permanent": true
    },
    {
      "source": "/services/social-media",
      "destination": "/services/creative-assistant",
      "permanent": true
    },
    {
      "source": "/services/virtual-assistance",
      "destination": "/services/virtual-assistant",
      "permanent": true
    },
    {
      "source": "/services/admin-support",
      "destination": "/services/virtual-assistant",
      "permanent": true
    },
    {
      "source": "/ai-content/real-estate",
      "destination": "/services/creative-assistant",
      "permanent": true
    },
    {
      "source": "/ai-content/fashion",
      "destination": "/services/creative-assistant",
      "permanent": true
    },
    {
      "source": "/ai-content/food",
      "destination": "/services/creative-assistant",
      "permanent": true
    },
    {
      "source": "/ai-content/products",
      "destination": "/services/creative-assistant",
      "permanent": true
    },
    {
      "source": "/ai-content/ai-advertising",
      "destination": "/services/creative-assistant",
      "permanent": true
    },
    {
      "source": "/ai-content/social-content",
      "destination": "/services/creative-assistant",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/social-post",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://images.unsplash.com https://*.public.blob.vercel-storage.com; media-src 'self' blob: https://*.public.blob.vercel-storage.com; connect-src 'self' https://vercel.com https://*.blob.vercel-storage.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
