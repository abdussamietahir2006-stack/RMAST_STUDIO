{
  "name": "rmast-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build:site": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "build": "npm run build:site && esbuild server.ts --bundle --platform=node --format=esm --packages=external --define:process.env.NODE_ENV=\\\"production\\\" --outfile=server.js",
    "start": "node server.js",
    "preview": "npm run build && npm start",
    "clean": "node -e \"for (const p of ['dist', 'dist-ssr', 'server.js']) require('fs').rmSync(p, { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.6.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
