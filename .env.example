# Copy to .env.local for local development. On Vercel, add these under
# Project Settings > Environment Variables instead.

# MONGODB_URI: MongoDB Atlas connection string. Stores leads, dashboard accounts,
# sessions and website media settings. Without it the dashboard is disabled.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
# MONGODB_DB: Optional database name (default "rmast_studio"). Keep it separate from
# databases used by other apps on the same cluster.
# MONGODB_DB="rmast_studio"

# BLOB_READ_WRITE_TOKEN: Vercel Blob store token for team photos and videos.
# Vercel adds it automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# GEMINI_API_KEY: Powers the Studio Assistant chat. Without it the chat uses scripted answers.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"

# SMTP_USER / SMTP_PASS: Account the server uses to email you every new inquiry.
# For Gmail: SMTP_USER is the Gmail address and SMTP_PASS is a 16-character
# App Password (Google Account > Security > 2-Step Verification > App passwords).
SMTP_USER="rmaststudio@gmail.com"
SMTP_PASS="MY_GMAIL_APP_PASSWORD"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# NOTIFY_EMAIL="rmaststudio@gmail.com"

# PORT: Local server port (default 3000). Not used on Vercel.
# PORT=3000

# Social media manager (dashboard > Social posts)
# CRON_SECRET: any long random string. Vercel sends it to /api/cron/social-post every morning to
# write the day's Instagram post idea. Without it the daily job is off (opening the dashboard
# still writes today's idea).
CRON_SECRET="LONG_RANDOM_STRING"
# SOCIAL_TIMEZONE: which day counts as "today" for the daily post (default Asia/Karachi).
# SOCIAL_TIMEZONE="Asia/Karachi"
